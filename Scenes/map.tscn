[sub_resource type="Resource" id="Resource_slgtx"]
script = ExtResource("6_x5dfk")
image_url = "https://res.cloudinary.com/bls4sbwz/image/upload/v1786643692/b12999.webp"
image_number = "b12999"
image_text = "Bagergade 71 (i dag Tinghusgade 28-34).
Opført 1859, oprindelig tænkt som stationsbygning.
1889 købt af Svendborg Bymission, der var tilknyttet Vor Frue kirke.
1985 afhændet til kontor-og butiksformål.
Billede fra ca. 1900."
metadata/_custom_type_script = "uid://dsk1lwbts52ij"

[sub_resource type="Resource" id="Resource_03dox"]
script = ExtResource("6_x5dfk")
image_url = "https://res.cloudinary.com/bls4sbwz/image/upload/v1786643687/b19662.webp"
image_number = "b19662"
image_text = "Bagergade i sne, med kanaphusene på venstre side. Ca. 1903."
metadata/_custom_type_script = "uid://dsk1lwbts52ij"

[sub_resource type="Resource" id="Resource_7h2y6"]
script = ExtResource("6_x5dfk")
image_url = "https://res.cloudinary.com/bls4sbwz/image/upload/v1786643681/b19722.webp"
image_number = "b19722"
image_text = "Logen Ørkild, Bagergade 59.
Bygningen opført 1895, til afholdsloge.
Blev senere, 1963 til Frimurerlogen. Billede fra ca. 1905."
metadata/_custom_type_script = "uid://dsk1lwbts52ij"

