image_number = "b102678"
image_text = "Ved kaj ved Østre Havn i Svendborg. Til venstre ses Petersen og Jensens pakhus. Skibet er Svafva af Svendborg. Svafva forliste i april 1902 efter en kollision med et isbjerg. Det holdtes på pumperne indtil 2 mil fra Husavik, Island men sank så der. Det lykkedes mandskabet at bjerge sig i bådene. Billede fra ca. 1901."
