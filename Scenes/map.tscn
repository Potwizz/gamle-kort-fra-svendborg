image_url = "https://res.cloudinary.com/bls4sbwz/image/upload/v1786637671/b102665.webp"
image_number = "b102665"
image_text = "Ariel af Svendborg, bygget i 1899 til Sejlskibsselskab-A/S Svendborg. Skibet blev bygget ved Andersen Jensens værft, Øxenbjerg.

Solgt i 1917 til Skien. Norge og fik navneændring til KODAN. Forlist 1917 i Atlanterhavet på rejse til Island med Tømmer. 
Torpederet af tysk ubåd."
metadata/_custom_type_script = "uid://dsk1lwbts52ij"

[sub_resource type="Resource" id="Resource_vuxmy"]
